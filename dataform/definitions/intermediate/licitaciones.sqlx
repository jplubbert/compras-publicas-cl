config {
  type: "incremental",
  schema: "silver",
  tags: ["silver"],
  uniqueKey: ["codigo_licitacion"],
  assertions: {
    uniqueKey: ["codigo_licitacion"],
    nonNull: ["codigo_licitacion", "fecha_publicacion", "fecha_cambio"],
    rowConditions: [
      "monto_estimado IS NULL OR monto_estimado >= 0",
      "fecha_cierre IS NULL OR fecha_cierre >= fecha_publicacion",
      "estado IS NOT NULL"
    ]
  },
  description: "Licitaciones de Mercado Público, una fila por código con su versión más reciente (REQ-008).",
  columns: {
    codigo_licitacion: "Código externo de la licitación (clave natural)",
    nombre: "Nombre de la licitación",
    codigo_estado: "Código numérico del estado de la licitación según la API",
    estado: "Estado de la licitación traducido del código (Publicada, Cerrada, Desierta, Adjudicada, Revocada, Suspendida); nulo si el código no está en el catálogo",
    tipo: "Tipo de licitación según la API (por ejemplo L1, LE, LP)",
    codigo_organismo: "Código del organismo comprador",
    nombre_organismo: "Nombre del organismo comprador",
    moneda: "Código de la moneda del monto estimado, en mayúsculas",
    monto_estimado: "Monto estimado de la licitación en su moneda",
    fecha_creacion: "Fecha de creación de la licitación (hora de Chile)",
    fecha_publicacion: "Fecha de publicación de la licitación (hora de Chile)",
    fecha_cierre: "Fecha de cierre de recepción de ofertas (hora de Chile)",
    fecha_adjudicacion: "Fecha de adjudicación de la licitación (hora de Chile)",
    run_id: "Identificador de la corrida de ingesta que trajo esta versión",
    _ingest_date: "Fecha UTC de inicio de la corrida que trajo esta versión (partición de raw)",
    ingested_at: "Momento UTC en que se recibió la respuesta de esta versión",
    fecha_cambio: "Momento del cambio que ordena las versiones; para licitaciones es ingested_at (S-14)"
  }
}

js {
  const columnas = [
    "codigo_licitacion", "nombre", "codigo_estado", "estado", "tipo", "codigo_organismo", "nombre_organismo", "moneda",
    "monto_estimado", "fecha_creacion", "fecha_publicacion", "fecha_cierre", "fecha_adjudicacion",
    "run_id", "_ingest_date", "ingested_at", "fecha_cambio"
  ];
}

WITH nuevas AS (
  SELECT
    JSON_VALUE(doc, '$.CodigoExterno') AS codigo_licitacion,
    JSON_VALUE(doc, '$.Nombre') AS nombre,
    SAFE_CAST(JSON_VALUE(doc, '$.CodigoEstado') AS INT64) AS codigo_estado,
    ${silver.estadoSql("SAFE_CAST(JSON_VALUE(doc, '$.CodigoEstado') AS INT64)", silver.ESTADOS_LICITACION)} AS estado,
    JSON_VALUE(doc, '$.Tipo') AS tipo,
    JSON_VALUE(doc, '$.Comprador.CodigoOrganismo') AS codigo_organismo,
    JSON_VALUE(doc, '$.Comprador.NombreOrganismo') AS nombre_organismo,
    UPPER(TRIM(JSON_VALUE(doc, '$.Moneda'))) AS moneda,
    ${silver.numericSql("JSON_VALUE(doc, '$.MontoEstimado')")} AS monto_estimado,
    ${silver.fechaSql("JSON_VALUE(doc, '$.Fechas.FechaCreacion')")} AS fecha_creacion,
    ${silver.fechaSql("JSON_VALUE(doc, '$.Fechas.FechaPublicacion')")} AS fecha_publicacion,
    ${silver.fechaSql("JSON_VALUE(doc, '$.Fechas.FechaCierre')")} AS fecha_cierre,
    ${silver.fechaSql("JSON_VALUE(doc, '$.Fechas.FechaAdjudicacion')")} AS fecha_adjudicacion,
    run_id,
    _ingest_date,
    ingested_at,
    ingested_at AS fecha_cambio
  FROM ${ref("mercadopublico_licitaciones")}, UNNEST(JSON_QUERY_ARRAY(payload, '$.Listado')) AS doc
  WHERE http_status = 200 AND payload IS NOT NULL AND tipo = 'detalle'
    AND ${reglas.pasaSql("licitaciones")}
    ${when(incremental(), `AND ${silver.ventanaIncremental(self())}`)}
),
candidatas AS (
  SELECT ${columnas.join(", ")} FROM nuevas
  ${when(incremental(), `UNION ALL
  SELECT ${columnas.join(", ")} FROM ${self()}
  WHERE codigo_licitacion IN (SELECT codigo_licitacion FROM nuevas)`)}
)
SELECT ${columnas.join(", ")} FROM candidatas
QUALIFY ROW_NUMBER() OVER (PARTITION BY codigo_licitacion ORDER BY fecha_cambio DESC, ingested_at DESC) = 1
