config {
  type: "assertion",
  tags: ["gold"],
  description: "Controles de gold.fct_licitaciones con filtro de partición (REQ-012): clave única y no nula, montos no negativos, dólar no posterior al documento, fx_imputado coherente y proveedor y organismo presentes en sus dimensiones; cada fila es una falla."
}

WITH f AS (
  SELECT * FROM ${ref("fct_licitaciones")} WHERE ${gold.filtroParticionSql(reglas.FECHA_MINIMA)}
)
SELECT 'clave_repetida' AS falla, codigo_licitacion, proveedor_key FROM f
  GROUP BY codigo_licitacion, proveedor_key HAVING COUNT(*) > 1
UNION ALL
SELECT 'clave_nula', codigo_licitacion, proveedor_key FROM f
  WHERE codigo_licitacion IS NULL OR fecha_documento IS NULL
UNION ALL
SELECT 'monto_negativo', codigo_licitacion, proveedor_key FROM f
  WHERE monto_adjudicado < 0 OR monto_adjudicado_clp < 0 OR monto_adjudicado_uf < 0 OR monto_adjudicado_usd < 0
UNION ALL
SELECT 'dolar_posterior', codigo_licitacion, proveedor_key FROM f WHERE fecha_dolar > fecha_documento
UNION ALL
SELECT 'fx_inconsistente', codigo_licitacion, proveedor_key FROM f
  WHERE fx_imputado != ${gold.fxImputadoSql("fecha_dolar", "fecha_documento")}
UNION ALL
SELECT 'proveedor_sin_dimension', codigo_licitacion, proveedor_key FROM f
  WHERE proveedor_key IS NOT NULL AND proveedor_key NOT IN (SELECT proveedor_key FROM ${ref("dim_proveedor")})
UNION ALL
SELECT 'organismo_sin_dimension', codigo_licitacion, proveedor_key FROM f
  WHERE codigo_organismo IS NOT NULL AND codigo_organismo NOT IN (SELECT codigo_organismo FROM ${ref("dim_comprador")})
