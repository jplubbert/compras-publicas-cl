config {
  type: "incremental",
  schema: "silver",
  tags: ["silver"],
  dependencies: ["generar_sal"],
  uniqueKey: ["proveedor_key"],
  assertions: {
    uniqueKey: ["proveedor_key"],
    nonNull: ["proveedor_key", "fecha_cambio"],
    rowConditions: [
      "(rut_empresa IS NULL) != (rut_persona_natural IS NULL)"
    ]
  },
  description: "Proveedores vistos en las órdenes de compra y en las adjudicaciones de ítems de licitación de Mercado Público, una fila por proveedor_key con su versión más reciente; el RUT va en rut_empresa o en rut_persona_natural (con policy tag) según la regla de S-04 (REQ-008, REQ-014, DEC-008).",
  columns: {
    proveedor_key: "Hash SHA-256 en hex de la sal de pii.sal y el RUT normalizado; clave del proveedor, sin policy tag (DEC-008)",
    rut_empresa: "RUT del proveedor si es persona jurídica (cuerpo del RUT de 50.000.000 o más, S-04); nulo si es persona natural",
    rut_persona_natural: {
      description: "RUT del proveedor si es persona natural (cuerpo del RUT menor que 50.000.000 o no numérico, S-04); nulo si es empresa. Protegido por la policy tag dato_personal.rut (REQ-014)",
      bigqueryPolicyTags: [gobierno.policyTagRut(dataform.projectConfig.vars)]
    },
    nombre_proveedor: "Nombre del proveedor en su versión más reciente",
    codigo_proveedor: "Código del proveedor en Mercado Público; nulo si la versión viene de una adjudicación de ítem",
    run_id: "Identificador de la corrida de ingesta que trajo esta versión",
    _ingest_date: "Fecha UTC de inicio de la corrida que trajo esta versión (partición de raw)",
    ingested_at: "Momento UTC en que se recibió la respuesta de esta versión",
    fecha_cambio: "Momento del cambio que ordena las versiones; para proveedores es ingested_at"
  }
}

js {
  const columnas = [
    "proveedor_key", "rut_empresa", "rut_persona_natural", "nombre_proveedor", "codigo_proveedor", "run_id",
    "_ingest_date", "ingested_at", "fecha_cambio"
  ];
}

WITH documentos AS (
  SELECT
    ${silver.rutSql("JSON_VALUE(doc, '$.Proveedor.RutSucursal')")} AS rut,
    JSON_VALUE(doc, '$.Proveedor.Nombre') AS nombre_proveedor,
    JSON_VALUE(doc, '$.Proveedor.Codigo') AS codigo_proveedor,
    run_id,
    _ingest_date,
    ingested_at,
    ingested_at AS fecha_cambio
  FROM ${ref("mercadopublico_ordenes_compra")}, UNNEST(JSON_QUERY_ARRAY(payload, '$.Listado')) AS doc
  WHERE http_status = 200 AND payload IS NOT NULL AND tipo = 'detalle'
    AND ${reglas.pasaSql("ordenes_compra")}
    ${when(incremental(), `AND ${silver.ventanaIncremental(self())}`)}
  UNION ALL
  SELECT
    ${silver.rutSql("JSON_VALUE(item, '$.Adjudicacion.RutProveedor')")} AS rut,
    JSON_VALUE(item, '$.Adjudicacion.NombreProveedor') AS nombre_proveedor,
    CAST(NULL AS STRING) AS codigo_proveedor,
    run_id,
    _ingest_date,
    ingested_at,
    ingested_at AS fecha_cambio
  FROM ${ref("mercadopublico_licitaciones")},
    UNNEST(JSON_QUERY_ARRAY(payload, '$.Listado')) AS doc,
    UNNEST(JSON_QUERY_ARRAY(doc, '$.Items.Listado')) AS item
  WHERE http_status = 200 AND payload IS NOT NULL AND tipo = 'detalle'
    AND ${reglas.pasaSql("licitaciones")}
    ${when(incremental(), `AND ${silver.ventanaIncremental(self())}`)}
),
nuevas AS (
  SELECT
    ${gobierno.proveedorKeySql("rut", ref("sal"))} AS proveedor_key,
    IF(${reglas.esPersonaNaturalSql("rut")}, NULL, rut) AS rut_empresa,
    IF(${reglas.esPersonaNaturalSql("rut")}, rut, NULL) AS rut_persona_natural,
    nombre_proveedor,
    codigo_proveedor,
    run_id,
    _ingest_date,
    ingested_at,
    fecha_cambio
  FROM documentos
  WHERE rut IS NOT NULL
),
candidatas AS (
  SELECT ${columnas.join(", ")} FROM nuevas
  ${when(incremental(), `UNION ALL
  SELECT ${columnas.join(", ")} FROM ${self()}
  WHERE proveedor_key IN (SELECT proveedor_key FROM nuevas)`)}
)
SELECT ${columnas.join(", ")} FROM candidatas
QUALIFY ROW_NUMBER() OVER (PARTITION BY proveedor_key ORDER BY fecha_cambio DESC, ingested_at DESC) = 1
