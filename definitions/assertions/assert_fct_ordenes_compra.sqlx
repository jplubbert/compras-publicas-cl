config {
  type: "assertion",
  tags: ["gold"],
  description: "Controles de gold.fct_ordenes_compra con filtro de partición (REQ-012): clave única y no nula, montos no negativos, dólar no posterior al documento, fx_imputado coherente y proveedor y organismo presentes en sus dimensiones; cada fila es una falla."
}

WITH f AS (
  SELECT * FROM ${ref("fct_ordenes_compra")} WHERE ${gold.filtroParticionSql(reglas.FECHA_MINIMA)}
)
SELECT 'clave_repetida' AS falla, codigo_oc, proveedor_key FROM f
  GROUP BY codigo_oc, proveedor_key HAVING COUNT(*) > 1
UNION ALL
SELECT 'clave_nula', codigo_oc, proveedor_key FROM f
  WHERE codigo_oc IS NULL OR fecha_documento IS NULL OR proveedor_key IS NULL
UNION ALL
SELECT 'monto_negativo', codigo_oc, proveedor_key FROM f
  WHERE total < 0 OR monto_clp < 0 OR monto_uf < 0 OR monto_usd < 0
UNION ALL
SELECT 'dolar_posterior', codigo_oc, proveedor_key FROM f WHERE fecha_dolar > fecha_documento
UNION ALL
SELECT 'fx_inconsistente', codigo_oc, proveedor_key FROM f
  WHERE fx_imputado != ${gold.fxImputadoSql("fecha_dolar", "fecha_documento")}
UNION ALL
SELECT 'proveedor_sin_dimension', codigo_oc, proveedor_key FROM f
  WHERE proveedor_key IS NOT NULL AND proveedor_key NOT IN (SELECT proveedor_key FROM ${ref("dim_proveedor")})
UNION ALL
SELECT 'organismo_sin_dimension', codigo_oc, proveedor_key FROM f
  WHERE codigo_organismo IS NOT NULL AND codigo_organismo NOT IN (SELECT codigo_organismo FROM ${ref("dim_comprador")})
