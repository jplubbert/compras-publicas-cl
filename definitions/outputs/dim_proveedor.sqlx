config {
  type: "table",
  schema: "gold",
  tags: ["gold"],
  dependOnDependencyAssertions: true,
  assertions: {
    uniqueKey: ["proveedor_key"],
    nonNull: ["proveedor_key"],
    rowConditions: [
      "(rut_empresa IS NULL) != (rut_persona_natural IS NULL)"
    ]
  },
  description: "Dimensión de proveedores de Mercado Público, una fila por proveedor con su versión más reciente; el RUT va en rut_empresa o en rut_persona_natural (con policy tag) según la regla de S-04 (REQ-012, REQ-014, DEC-008).",
  columns: {
    proveedor_key: "Clave del proveedor: hash SHA-256 en hex de la sal de pii.sal y el RUT normalizado, sin policy tag (DEC-008)",
    rut_empresa: "RUT del proveedor si es persona jurídica (cuerpo del RUT de 50.000.000 o más, S-04); nulo si es persona natural",
    rut_persona_natural: {
      description: "RUT del proveedor si es persona natural (cuerpo del RUT menor que 50.000.000 o no numérico, S-04); nulo si es empresa. Protegido por la policy tag dato_personal.rut (REQ-014)",
      bigqueryPolicyTags: [gobierno.policyTagRut(dataform.projectConfig.vars)]
    },
    nombre_proveedor: "Nombre del proveedor en su versión más reciente",
    codigo_proveedor: "Código del proveedor en Mercado Público; nulo si la versión viene de una adjudicación de ítem",
    fecha_cambio: "Momento de la versión más reciente del proveedor en silver"
  }
}

SELECT
  proveedor_key,
  rut_empresa,
  rut_persona_natural,
  nombre_proveedor,
  codigo_proveedor,
  fecha_cambio
FROM ${ref("proveedores")}
